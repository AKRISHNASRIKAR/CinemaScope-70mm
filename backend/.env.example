# PostgreSQL connection — Supabase local default
# For production, use the Pooler (Transaction mode) URL from Supabase Dashboard → Settings → Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase project credentials
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # NEVER expose to client; server-only

# TMDB API — stored server-side only, never shipped to the browser
# Get from: https://www.themoviedb.org/settings/api
# Store in Supabase Vault (Dashboard → Edge Functions → Secrets) for production
TMDB_API_KEY=your-tmdb-api-key

# CORS — comma-separated list of allowed origins for Edge Function responses
ALLOWED_ORIGINS=http://localhost:5173,https://your-production-domain.vercel.app

# ── CI/CD (GitHub Actions) ──────────────────────────────────────────────────
# These go into GitHub → Settings → Secrets → Actions, NOT into this file.
# Listed here for reference only.
#
# SUPABASE_ACCESS_TOKEN  = your personal Supabase token (account settings → access tokens)
# SUPABASE_PROJECT_REF   = your project reference ID (e.g. "abcxyzabcxyz")
# SUPABASE_DB_PASSWORD   = your database password
# SUPABASE_PROJECT_URL   = https://your-project-ref.supabase.co (used in smoke test)
