# Supabase — auth, watchlist, watch history, ratings
# Get these from your Supabase project settings -> API
VITE_SUPABASE_URL=https://jdcwheqgijtzfbxxvnjx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# TMDB for local dev — read by the Vite dev-server proxy (vite.config.js),
# never bundled into client code. Pick one:
#   a) forward to the deployed proxy (no key needed; also works on networks
#      that block api.themoviedb.org)
TMDB_DEV_PROXY=https://cscope.pages.dev/api/tmdb
#   b) call TMDB directly
# TMDB_API_KEY=your-tmdb-api-key
# In production the key is a Cloudflare Pages secret used by functions/api/tmdb.

# Optional: only if the frontend is hosted apart from the TMDB proxy.
# VITE_TMDB_PROXY_URL=https://cscope.pages.dev/api/tmdb

# External links
VITE_GITHUB_URL=https://github.com/YOUR_USERNAME
